# ---------------------------------------------------------------------------
# Everything here has a working default baked into docker-compose.yml.
# You only need a .env file if you want REAL Stripe test mode (see below).
# ---------------------------------------------------------------------------

# --- Stripe -----------------------------------------------------------------
# Leave BOTH of these blank and the platform runs its local payment adapter:
# same Checkout-Session shape, same HMAC-signed webhook, same idempotency code
# path — so a reviewer with no Stripe account still completes a real purchase.
# Fill them in and the identical code talks to Stripe test mode instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used by the local payment adapter to sign its webhooks. Ignored when the
# Stripe keys above are set.
LOCAL_PAYMENT_WEBHOOK_SECRET=whsec_local_dev_secret

# --- Public URLs (used for Stripe redirect targets) -------------------------
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
