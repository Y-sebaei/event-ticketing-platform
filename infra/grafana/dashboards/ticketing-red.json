{
  "uid": "ticketing-red",
  "title": "Ticketing — RED metrics",
  "description": "Rate, errors and duration per endpoint, plus the checkout funnel and the async pipeline. Provisioned from infra/grafana/dashboards; edits made in the UI are not persisted.",
  "tags": [
    "ticketing",
    "red",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_request_duration_milliseconds_count, http_route)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RED — the three numbers that describe an endpoint",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rate — requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_milliseconds_count{http_route=~\"$route\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors — percentage of requests failing",
      "description": "Client errors and server errors are separated because they mean different things: 4xx is usually a sold-out ticket type, 5xx is ours.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_milliseconds_count{error_type=\"server\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_milliseconds_count[5m])), 0.001)",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_milliseconds_count{error_type=\"client\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_milliseconds_count[5m])), 0.001)",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duration — p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_milliseconds_bucket{http_route=~\"$route\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_milliseconds_bucket{http_route=~\"$route\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_milliseconds_bucket{http_route=~\"$route\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Checkout funnel — where orders stop",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Orders created / paid / tickets issued",
      "description": "The three counters should track each other. A gap between paid and issued means the fulfilment consumer is behind or stuck, and customers have been charged without receiving tickets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 6,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(orders_created_total[5m]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(increase(orders_paid_total[5m]))",
          "legendFormat": "paid"
        },
        {
          "refId": "C",
          "expr": "sum(increase(tickets_issued_total[5m]))",
          "legendFormat": "tickets issued"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Replays stopped by an idempotency guard",
      "description": "Non-zero here is healthy: it means a webhook was replayed or a message redelivered, and the guard caught it. Zero forever usually means the guards are never being exercised.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (guard) (increase(idempotency_suppressed_total[5m]))",
          "legendFormat": "{{guard}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Async pipeline — outbox, Kafka, consumers",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Outbox backlog",
      "description": "Rows written but not yet published to Kafka. This is the single most important number on the dashboard: if it climbs and stays up, orders are paid for and not being fulfilled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 19
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(outbox_pending)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Kafka messages consumed, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 6,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, outcome) (rate(messaging_consumed_total[1m]))",
          "legendFormat": "{{topic}} — {{outcome}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Inventory gRPC latency (p95)",
      "description": "The order service's only synchronous dependency. When checkout gets slow, this is the first place to look.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate(rpc_client_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Search index failures",
      "description": "A failed index write never fails event creation; it retries and then dead-letters. This panel is how you find out it happened.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(search_index_failures_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Connected realtime clients",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(realtime_connections)",
          "legendFormat": "sockets"
        }
      ]
    }
  ]
}
